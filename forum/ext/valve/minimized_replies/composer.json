{
    "name": "valve/minimized_replies",
    "type": "phpbb-extension",
    "description": "vBulletin-style minimized replies system for Steam forum themes",
    "homepage": "https://steampowered.com",
    "version": "1.0.0",
    "time": "2024-12-27",
    "license": "GPL-2.0-only",
    "authors": [
        {
            "name": "Valve Corporation",
            "homepage": "https://valvesoftware.com",
            "role": "Lead Developer"
        }
    ],
    "require": {
        "php": ">=7.1.3",
        "composer/installers": "~1.0"
    },
    "extra": {
        "display-name": "Steam Forum Minimized Replies",
        "soft-require": {
            "phpbb/phpbb": ">=3.3.0,<4.0.0@dev"
        },
        "version-check": {
            "host": "steampowered.com",
            "directory": "/forum/version",
            "filename": "minimized_replies.json"
        }
    }
}