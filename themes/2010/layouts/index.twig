<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.01 Transitional//EN" "http://www.w3.org/TR/html4/loose.dtd">
<html>
<head>
<meta content="text/html; charset=utf-8" http-equiv="Content-Type"/>
<title>Welcome to Steam</title>
<link href="css/styles_storev5.css" rel="stylesheet" type="text/css"/>
<!--[if lte IE 6]> <link href="css/styles_storev5_ie6.css" rel="stylesheet" type="text/css" /> <![endif]-->
<!--[if lte IE 7]> <style type="text/css"> .iepoupfix{ display: block; } </style> <![endif]-->
<script src="js/swfobject.js" type="text/javascript"></script>
<script src="js/prototype.js" type="text/javascript"></script>
<script src="js/scriptaculous.js" type="text/javascript"></script>
<script src="js/javascript.js" type="text/javascript"></script>
<script src="js/main.js" type="text/javascript"></script>
<script src="js/header.js" type="text/javascript"></script>
<script src="js/search.js" type="text/javascript"></script>
<script src="js/cluster.js" type="text/javascript"></script>
</head>
<body>
<div id="global_header">
	<div class="content">
		<div class="logo">
			<span id="logo_holder">
				<a href="{{ base_url }}">
					<img height="44" src="images/v5/globalheader_logo.png" width="176"/>
				</a>
			</span>
		</div>
		{{ global_header_menu_2010() }}
		<div id="global_actions">
			<div id="global_action_menu">
				{{ login_status() }}
				{{ language_dropdown() }}
			</div>
		</div>
	</div>
</div>

<div id="store_header">
	<div class="content">
		<div id="store_controls">
			<div id="cart_status_data">
				{{ cart_status() }}
			</div>
		</div>
		<div id="store_nav_area">
			<div class="store_nav_leftcap"></div>
			<div class="store_nav_bg">
				<div class="store_nav">
					<a class="tab active" href="{{ base_url }}">Featured Items</a>
					{{ genre_flyout_menu() }}
					<a class="tab" href="{{ base_url }}freestuff/demos/">Demos</a>
					<a class="tab" href="{{ base_url }}freestuff/videos/">Videos</a>
					<a class="tab" href="{{ base_url }}browse/mac">
						<img class="platform_small" height="16" src="images/v5/platforms/platform_mac_16.png" style="vertical-align: text-bottom;" width="16"/> Mac
					</a>
					<div id="store_search">
						{{ store_search_form() }}
					</div>
				</div>
			</div>
			<div class="store_nav_rightcap"></div>
		</div>
	</div>
</div>

<script type="text/javascript">
	var g_SteamID = 0;
</script>

<!-- Main Background -->
<div id="main">
	<div id="main_content">
		<!-- Promo Area -->
		<div class="promo_area">
			{{ featured_promo_banner() }}
		</div>

		<div class="leftcol">
			<!-- Main Cluster Carousel -->
			<div id="home_main_cluster">
				<div class="main_cluster_content">
					{{ storefront_cluster_carousel_2010() }}
				</div>
				<div id="home_cluster_controls">
					<div id="home_cluster_control_left"><img src="images/v5/cluster_control_left.png"/></div>
					<div id="home_cluster_control_right"><img src="images/v5/cluster_control_right.png"/></div>
				</div>
			</div>

			<!-- Daily Deal -->
			<div id="home_dailydeal" class="home_ctn">
				{{ daily_deal_section() }}
			</div>

			<!-- Mac Games Section -->
			<div id="home_mac_games" class="home_ctn">
				<h2 class="home_title">Available on Mac</h2>
				<div class="home_block">
					{{ mac_games_carousel() }}
				</div>
			</div>

			<!-- Tabs: New Releases, Top Sellers, Coming Soon, Specials -->
			<div class="tabarea">
				<div class="tabbar">
					<div class="tab active" onclick="TabSelect( this, 'tab_1_content' );">New releases</div>
					<div class="tab" onclick="TabSelect( this, 'tab_2_content' );">Top Sellers</div>
					<div class="tab" onclick="TabSelect( this, 'tab_3_content' );">Coming soon</div>
					<div class="tab" onclick="TabSelect( this, 'tab_discounts_content' );">Specials</div>
					<div style="clear: left;"></div>
				</div>
				<div class="tab_content_ctn">
					<div id="tab_1_content">
						{{ storefront_tab_content_v5('new_releases') }}
					</div>
					<div id="tab_2_content" style="display: none;">
						{{ storefront_tab_content_v5('top_sellers') }}
					</div>
					<div id="tab_3_content" style="display: none;">
						{{ storefront_tab_content_v5('coming_soon') }}
					</div>
					<div id="tab_discounts_content" style="display: none;">
						{{ storefront_tab_content_v5('specials') }}
					</div>
				</div>
			</div>
		</div>

		<div class="rightcol">
			<!-- Spotlight Section -->
			<div id="home_spotlight" class="home_ctn">
				{{ storefront_spotlight_v5() }}
			</div>

			<!-- Steam News -->
			<div id="home_news" class="home_ctn">
				<h2 class="home_title">Steam News</h2>
				{{ news_sidebar_list_v5() }}
			</div>

			<!-- Recommended Games -->
			<div id="home_recommendations" class="home_ctn">
				{{ recommendations_sidebar() }}
			</div>
		</div>

		<div style="clear: both;"></div>
	</div>
</div>

<!-- Global Hover Popup -->
<div class="popup_block" id="global_hover" style="display: none;">
	<div class="shadow_ul"></div><div class="shadow_top"></div><div class="shadow_ur"></div>
	<div class="shadow_left"></div><div class="shadow_right"></div>
	<div class="shadow_bl"></div><div class="shadow_bottom"></div><div class="shadow_br"></div>
	<div class="popup_body shadow_content" id="global_hover_content"></div>
</div>

{{ footer_2010() }}

</body>
</html>
