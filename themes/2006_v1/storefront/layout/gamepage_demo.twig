<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.01 Transitional//EN">
<head>
<meta content="text/html; charset=utf-8" http-equiv="Content-Type"/>
<title>Steam - {{ game.title }}</title>
<link href="styles_global.css" rel="stylesheet" type="text/css"/>
<link href="styles_content.css" rel="stylesheet" type="text/css"/>
<script src="swfobject.js" type="text/javascript"></script>
<script language="JavaScript" src="minmax.js"></script>
<script language="JavaScript" src="javascript.js"></script>
<script language="JavaScript" src="cookies.js"></script>
<script language="JavaScript" src="collapse.js"></script>
<script language="JavaScript" src="height_fixer.js"></script>
<script language="JavaScript">
<!--
function screenshot_popup( url, width, height )
{
    if ( screen.width >= 1280 && screen.height >= 1024 )
        popup( url+'&size=1024', 1024, 803, 0, 0 );
    else
        popup( url+'&size=800', 800, 635, 0, 0 );
}
-->
</script>
</head>
<body>
<div style="display: none;">
<img alt="" src="img/btn_install_over.jpg"/>
<img alt="" src="img/btn_media_over.jpg"/>
<img alt="" src="img/btn_purchase_over.jpg"/>
<img alt="" src="img/btn_purchase_pkg_over.jpg"/>
<img alt="" src="img/btn_right_wd_over.jpg"/>
<img alt="" src="img/btn_preLoad_ovr.jpg"/>
</div>
<!-- header bar -->
{{ header(true) }}
<!-- end header bar -->
<center>
<div class="contentBG_2">
<div class="headerBG_2">
<!-- Left Menu -->
<div class="leftMenu_2">
<div class="menu_item"><a href="index.php">Home</a></div>
<hr class="menu_spacer"/>
<div class="menu_item_current"><a href="index.php?area=all&">All Games</a></div>
<div class="menu_item"><a href="index.php?area=browse&">Browse Games</a></div>
<div class="menu_item"><a href="index.php?area=search&">Search</a></div>
<hr class="menu_spacer"/>
<div class="menu_item"><a href="index.php?area=free&">Free Stuff</a></div>
<div class="menu_item"><a href="index.php?area=media&">Videos</a></div>
</div>
<!-- End Left Menu -->
<!-- Left Column Content -->
<div class="leftCol_2">
<div class="detail_brandArea"><img src="gfx/apps/{{ game.appid }}/header.jpg"/></div>
<div class="detail_screenArea">
<table cellpadding="0" cellspacing="2" width="100%">
<tr>
{% for img in images %}
<td align="center" width="20%"><img border="0" onclick="screenshot_popup('{{ BASE }}/storefront/images.php?appid={{ game.appid }}&id={{ img }}', 800, 635, 0, 0);" src="{{ BASE }}/storefront/images/apps/{{ game.appid }}/screenshots/{{ img }}" style="cursor: pointer;"/></td>
{% endfor %}
</tr>
</table>
</div>
<!-- Install button for demo -->
<div><br/><a class="detail_purchase" href="steam://install/{{ game.appid }}">
<table background="img/btn_purchase.jpg" border="0" cellpadding="0" cellspacing="0" height="62" onmouseout="this.style.background='url(img/btn_purchase.jpg)'" onmouseover="this.style.background='url(img/btn_install_over.jpg)'" style="cursor:pointer; " width="460">
<tr>
<td align="center" width="40"><img border="0" height="24" src="img/ico/ico_install.gif" width="24"/></td>
<td align="left"><span class="detail_purchaseSuper">click to install </span><br>
<span class="detail_installTitle">{{ game.title }}</span></td>
<td align="right"> </td>
</tr>
</table>
</a>
</div>
<!-- About the Game -->
<div><h1>About the Game</h1>
<p>{{ game.description|raw }}</p></div>
<br clear="all"/>
</div>
<!-- End Left Column Content -->
<!-- Right Column Content -->
<div class="rightCol_2">
<!-- Metacritic score -->
{% if game.metascore_score %}
<div class="rightCol_2_top_mc" onclick="window.open( '{{ game.metascore_url }}', '_blank' );" style="cursor: pointer; display: block;">{{ game.metascore_score }}</div>
<div><a class="rightLink" href="{{ game.metascore_url }}" style="display: block;" target="_blank"><img border="0" height="11" src="img/ico/ico_arrow_grey.gif" width="28">  Read Critic Reviews</a></div>
{% endif %}
<br clear="all"/>
<div class="rightCol_2_Hr"></div>

<!-- This Game block - links to the parent game -->
{% if parent_game %}
<div class="usr_edit_right_header"><div style="float:left; ">This Game</div></div>
<a class="rightLink_game" href="index.php?area=game&AppId={{ parent_game.appid }}">
<span class="rightLink_gameTitle"><img alt="{{ parent_game.name }}" border="0" height="83" src="gfx/apps/{{ parent_game.appid }}/capsule_sm.jpg" title="{{ parent_game.name }}" width="222"/></span>
</a>
<div class="rightCol_2_Hr"></div>
<br class="not_in_ie"/>
{% endif %}

<!-- Video Highlight -->
{% if game.show_trailer and game.trailer_url %}
<div class="usr_edit_right_header" id="flash_movie" onclick="toggle_section( 'flash_movie' );" style="cursor: pointer;">
<div id="flash_movie_label" style="float:left; "> Video Highlight </div>
<div class="usr_edit_right_control"><img border="0" height="14" id="flash_movie_header" width="14"/></div>
</div>
<div id="flash_movie_content">
<div class="rightCol_2_Hr"></div>
<div class="rightCol_2_vid" id="videoContainer">
<p>If you wish to watch the trailer for this game, you will need to <a href="http://www.adobe.com/go/getflashplayer" target="_blank">Download</a> the Flash plugin.</p>
</div>
<script type="text/javascript">
var so = new SWFObject("vid_ctn.swf?fileID={{ game.trailer_url }}&title=Click to watch the low-res trailer ", "movie", "230", "160", "8", "#000000");
so.write("videoContainer");
</script>
<div class="rightCol_2_Hr_vid"></div>
<br class="not_in_ie"/>
</div>
<script>
check_section( 'flash_movie', 'open' );
</script>
{% endif %}

<!-- Media + Links -->
<div class="usr_edit_right_header" id="MediaAndLinks" onclick="toggle_section( 'media_links' );" style="cursor: pointer;">
<div style="float:left; "> Media + Links </div>
<div class="usr_edit_right_control"><img border="0" height="14" id="media_links_header" width="14"/></div>
</div>
<div id="media_links_content">
{% if game.website_url %}
<div><a class="rightLink" href="{{ game.website_url }}" target="_blank"><img align="absmiddle" border="0" height="17" src="img/ico/ico_web.gif" width="28">  visit the website </a></div>
{% endif %}
<div><a class="rightLink" href="http://forums.steampowered.com/" target="_blank"><img align="absmiddle" border="0" height="17" src="img/ico/ico_chat.gif" width="28">  visit the forums </a></div>
<br clear="all"/>
</div>
<script>
check_section( 'media_links', 'open' );
</script>

<!-- Game Details -->
<div class="usr_edit_right_header" id="gameDetails" onclick="toggle_section( 'game_details' );" style="cursor: pointer;">
<div style="float:left; "> Game Details </div>
<div class="usr_edit_right_control"><img border="0" height="14" id="game_details_header" width="14"/></div>
</div>
<div id="game_details_content">
<p>
<strong>Title :</strong> {{ game.title }}<br/>
{% if game.developer %}
<strong>Developer :</strong> {{ game.developer }}<br/>
{% endif %}
{% if game.release_date %}
<strong>Release Date :</strong> {{ game.release_date }}<br/>
{% endif %}
<strong>Languages :</strong> English<br/>
</p>
<div>
<div class="rightCol_2_specBox"><img align="absmiddle" height="17" src="img/ico/ico_singlePlayer.gif" width="26">  <strong>Single-player</strong></div>
<div class="rightCol_2_specBox"><img align="absmiddle" height="16" src="img/ico/ico_demo.gif" width="26">  <strong>Game demo</strong></div>
</div>
<br clear="all"/>
</div>
<script>
check_section( 'game_details', 'open' );
</script>

<!-- System Requirements -->
<div class="usr_edit_right_header" id="sysReqs" onclick="toggle_section( 'sys_req' );" style="cursor: pointer;">
<div style="float:left; "> System Requirements </div>
<div class="usr_edit_right_control"><img border="0" height="14" id="sys_req_header" width="14"/></div>
</div>
<div id="sys_req_content">
{% if game.minimumreqs %}
<p><strong>Minimum:</strong> {{ game.minimumreqs }}</p>
{% endif %}
{% if game.recommendedreqs %}
<p><strong>Recommended:</strong> {{ game.recommendedreqs }}</p>
{% endif %}
</div>
<script>
check_section( 'sys_req', 'open' );
</script>

<a name="awards"></a>
</div>
<!-- End Right Column Content -->
<br clear="left">
</div>
<br clear="all">
</div>
<!-- Footer Content -->
<div class="footer">
<form action="game.php">
<input name="appid" type="hidden" value="{{ game.appid }}"/>
<table background="img/img_footer_bg.jpg" border="0" cellpadding="0" cellspacing="0" width="910px">
<tr>
<td background="img/img_footer_l.jpg" height="73" width="12"> </td>
<td align="center" width="110"><a href="http://www.valvesoftware.com"><img alt="link: Valve Software" border="0" height="26" src="img/logo_valve_footer.jpg" width="92"/></a></td>
<td>
<div class="legal">
<select name="l" onchange="submit();">
<option selected="" value="english">English</option>
<option value="french">French</option>
<option value="german">German</option>
<option value="italian">Italian</option>
<option value="spanish">Spanish</option>
</select><br>
&copy; 2006 Valve Corporation. All rights reserved. All trademarks are property of their respective owners in the US and other countries.<br>
<a href="http://www.valvesoftware.com/privacy.htm"> Privacy Policy.</a> <a href="http://www.valvesoftware.com/legal.htm">Legal.</a> <a href="/index.php?area=subscriber_agreement">Steam Subscriber Agreement.</a>
</div>
</td>
<td background="img/img_footer_r.jpg" height="73" width="14"> </td>
</tr>
</table>
</form>
</div>
<!-- End Footer Content -->
<br/>
</center>
</body>
