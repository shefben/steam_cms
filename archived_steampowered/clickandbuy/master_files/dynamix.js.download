// moved here, was in startoben.html before /
function mvwin(url) {
      if (url.match(/^javascript:/i)) return true;

      if (window.name == "firstgatezss" && top.opener && top.opener.location && !top.opener.closed) {
          top.opener.location.href=url;
	  top.opener.focus();
	  top.close();
	  return false;
      } else {
         window.location.href=url;
      }
}


