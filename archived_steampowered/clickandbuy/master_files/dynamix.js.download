//
// ossip testing. takes input field name, assumes label with id=field+'label'
//  needs to be more generic 

function toggleError (field,onoff) {
  var inp=document.getElementsByName(field)[0];
  var lab=document.getElementById(field + '_label');
  var err=document.getElementById(field + '_error');

  if(onoff) { // set on = no error
      if (lab) lab.style.color = '#404040';
      if (err) err.style.display = 'none';  // IE ?
      inp.style.border = '1px solid #7f9db9';
      return true;

  } else { // set off = error
      if (lab) lab.style.color = '#D20F15';
      if (err) err.style.display = 'block';
      inp.style.border = '1px solid #D20F15';
      return false;
  }
}

function checkifempty (field, len) {
  var inp=document.getElementsByName(field)[0];
   return toggleError(field, inp.value != '' && inp.value.length >= len);
}

function checkEmail (field) {
  var inp=document.getElementsByName(field)[0];
  return toggleError(field, inp.value != '' && inp.value.length > 6 
	&& inp.value.indexOf('@')>=0 && inp.value.indexOf('@')<inp.value.length -4)
}

