			if ( document.selectfunding.fundingtype[i].value == paymentType ){
				document.selectfunding.fundingtype[i].checked =  1  
   			}	 
		}
	}
	
}

// V520 Javascript functions
function showregisterpayment ( id, img, hide, focuselement ){

	if( paymentoptioncount == 1 ){	
		return
	}

	if( id && document.getElementById(id) && hide ){
		document.regform._paymenttype.value = "";

		if( document.getElementById(id) )
			document.getElementById(id).style.display = 'none';


		if( id == "creditcard" ){
			if( document.getElementById(id+'2') )
				document.getElementById(id+'2').style.display = 'none';

			if( ccaddressrequired )
				hidebillingaddress()

		}
	
		if( document.getElementById(id+'hr') )
			document.getElementById(id+'hr').style.display = 'none';

		if( document.getElementById(id+'label') )
			document.getElementById(id+'label').style.display = 'none';

		if( document.getElementById(id+'labellink'))
			document.getElementById(id+'labellink').style.display = 'block';	

	}else if(  id && document.getElementById(id) ){

		document.regform._paymenttype.value = id;
		
					

		if( document.getElementById(id+'label') )
			document.getElementById(id+'label').style.display = 'block';
		
		if( document.getElementById(id+'labellink'))
			document.getElementById(id+'labellink').style.display = 'none';	

		if( document.getElementById(id) )
			document.getElementById(id).style.display = 'block';


		if( id == "creditcard" ){
			if( document.getElementById(id+'2') )
				document.getElementById(id+'2').style.display = 'block';

			if( ccaddressrequired )
				setbillingaddress()

		}


		if( document.getElementById(id+'hr') )
			document.getElementById(id+'hr').style.display = 'block';
		

		// set focus
		if( focuselement && eval("document.regform."+focuselement ) ){

			eval("document.regform."+focuselement ).focus();

		}else if( id == "creditcard" ){
		
			if( document.regform.Kartentyp && document.regform.Kartentyp.selectedIndex == 0 )
				document.regform.Kartentyp.focus();
			else if( document.regform.Kreditkartennummer )  
				document.regform.Kreditkartennummer.focus();

		}else if ( id == "directdebit" && document.regform.Konto ){
		
			document.regform.Bank.focus();

		}else if ( id == "omt" && document.regform.Konto ){
	
			document.regform.OMT_Konto.focus();

		}else if ( id == "wgz" && document.regform.Konto ){
	
			document.regform.WGZ_Konto.focus();
		}

	}


	if( img && img == "arrowup" ){
		if(document.getElementById(id+'arrowup') ) {
			document.getElementById(id+'arrowup').style.display = 'none';
		}
		if( document.getElementById(id+'arrowdown') )
			document.getElementById(id+'arrowdown').style.display = 'block';
	}
	if( img && img == "arrowdown" ){
		if( document.getElementById(id+'arrowdown') )
			document.getElementById(id+'arrowdown').style.display = 'none';
	
		if( document.getElementById(id+'arrowup') )
			document.getElementById(id+'arrowup').style.display = 'block';
	}

	for( i=0; i<payments.length;i++){
		p = payments[i];
		if( p != id && document.getElementById(p) ){
	
			document.getElementById(p).style.display = 'none';
			
			if( document.getElementById(p+'2') )
				document.getElementById(p+'2').style.display = 'none';	
	
			if( document.getElementById(p+'label') )
				document.getElementById(p+'label').style.display = 'none';

			if( document.getElementById(p+'labellink'))
				document.getElementById(p+'labellink').style.display = 'block';


			if( document.getElementById(p+'arrowdown') )
				document.getElementById(p+'arrowdown').style.display = 'none';
	
			if( document.getElementById(id+'arrowup') )
				document.getElementById(p+'arrowup').style.display = 'block';

			if( 	document.getElementById(p+'hr') )
				document.getElementById(p+'hr').style.display = 'none';
		}
	}


	// hide credit card billing address block	
	if( (id && id != "creditcard") || (id == "creditcard" && img && img == "arrowdown") ) {
		if( document.getElementById('ccbillingaddress2') )
	 		document.getElementById('ccbillingaddress2').style.display = 'none';


		if( document.getElementById('ccbillingaddress') )
	 		document.getElementById('ccbillingaddress').style.display = 'none';
	}


	if( document.regform.ddccfallback && document.regform.ddccfallback.value && id ){


		if( document.getElementById('dd_creditcard2') ) {
	 		
			if( (img && img == "arrowdown") || id != 'directdebit' )
				document.getElementById('dd_creditcard2').style.display = 'none';
			else
				document.getElementById('dd_creditcard2').style.display = 'block';	
		}	



		if( document.getElementById('dd_ccbillingaddress2') ) {
	 		
			if( (img && img == "arrowdown") || id != 'directdebit' )
				document.getElementById('dd_ccbillingaddress2').style.display = 'none';
			else
				document.getElementById('dd_ccbillingaddress2').style.display = 'block';	
		}		

		if( document.getElementById('dd_ccbillingaddress') ) {

			if( img && img == "arrowdown" )
				document.getElementById('dd_ccbillingaddress').style.display = 'none';
			else
				document.getElementById('dd_ccbillingaddress').style.display = 'block';

		}
	}
}

function setbillingaddress() {

	if( document.getElementById('ccbillingaddress2') )
		document.getElementById('ccbillingaddress2').style.display = 'block';

	if( document.getElementById('ccbillingaddress') )
		document.getElementById('ccbillingaddress').style.display = 'block';

}

function hidebillingaddress() {

	if( document.getElementById('ccbillingaddress2') )
		document.getElementById('ccbillingaddress2').style.display = 'none';

	if( document.getElementById('ccbillingaddress') )
		document.getElementById('ccbillingaddress').style.display = 'none';

}


function setbillingaddress_cardtype ( form, cardtypes, ccindex ){
	
	if ( ccaddressrequired )
			return; 

	var cardarray = cardtypes.split(",");

	count = 0;
	ok = 1;
	flag = 0;
	while ( count < cardarray.length && ok)
	{
		cc = cardarray[count];

		if( (!ccindex && cc == form[form.selectedIndex].value ) || ( form[ccindex] && cc ==  form[ccindex].value ) ){

			

			if( document.getElementById('ccbillingaddress2') )
				document.getElementById('ccbillingaddress2').style.display = 'block';

			if( document.getElementById('ccbillingaddress') )
				document.getElementById('ccbillingaddress').style.display = 'block';

			ok = null;
			flag = 1;
		}

		++count

	}

	if( !flag && document.getElementById('ccbillingaddress2') )
	 	document.getElementById('ccbillingaddress2').style.display = 'none';


	if( !flag && document.getElementById('ccbillingaddress') )
	 	document.getElementById('ccbillingaddress').style.display = 'none';



	if( ccindex )
		form.selectedIndex = ccindex;
}

function submitpayment ( form, field ) {

	form._paymenttype.value = field;
	form.submit()
}

function CopyEmail ( ) { 

	if (document.pspregform.PSPEmail.value && !document.regform.Email.value){ 
	document.regform.Email.value = document.pspregform.PSPEmail.value;
	}

}

//Auto-tab for PSP Dob

var isNN = (navigator.appName.indexOf("Netscape")!=-1);
function autoTab(input,len, e) {

	var keyCode = (isNN) ? e.which : e.keyCode;
	var filter = (isNN) ? [0,8,9] : [0,8,9,16,17,18,37,38,39,40,46];

	if(input.value.length >= len && !containsElement(filter,keyCode)) {

		input.value = input.value.slice(0, len);

		input.form[(getIndex(input)+1) % input.form.length].focus();	
	}


	function containsElement(arr, ele) {
		var found = false, index = 0;
	
		while(!found && index < arr.length)
			if(arr[index] == ele)
				found = true;
			else
				index++;

		return found;
	}	

	function getIndex(input) {
		var index = -1, i = 0, found = false;

		while (i < input.form.length && index == -1)
			if (input.form[i] == input)index = i;
			else i++;

		return index;
	}

	return true;
}

