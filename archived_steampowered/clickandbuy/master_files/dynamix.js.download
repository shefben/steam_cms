function keyDown(ee) {
	if (document.layers) { // 
	if (ee.modifiers & Event.SHIFT_MASK) shift = 1;
	}
	if (document.all) {
	if (window.event.shiftKey) shift = 1;
	}
}


function bl(x) {

	if (document) {
	fo = eval('document.regform');
	}
	for (i=0; i<fo.elements.length; i++) {
	if (x == fo.elements[i].name) e = i;
	}
	t = window.setTimeout("tab()",5);
}

function fc() {
	window.clearTimeout(t);
}

function tab() {

if (shift == 1) { 
	fo.elements[(e-1)].focus();
	e = null;
	shift = null;
	} else {
	fo.elements[(e+1)].focus();
	e = null;
	shift = null;
	}
}

