function setfirstregpaymenttype ( form, val ){
	var count = form.typ.length
	for( i =0 ;i<count;++i ){
		if( form.typ[i] ){
			if ( form.typ[i].value == val ){
				form.typ[i].checked =  1  
   			}	 
		}
	}
}

function usphonebillprivatedata ( form, field ){
	var privatedata = form.privatedata.value;
	var privandarray = privatedata.split( "#" );
	var count = 0;
	var ok = 1;
	while ( count < privandarray.length && ok)
	{
		fields = privandarray[count]
		var fieldarray = fields.split( "," );
		if( fields.match( field ) ){
			i = 0;	
			while ( i < fieldarray.length ){
				str = fieldarray[i]
				if( str != field ){
					if( str == "SSN" ){
						form.USPhone_SSN1.value = "";
						form.USPhone_SSN2.value = "";
						form.USPhone_SSN3.value = "";

					}else if( str == "BIRTHDATE"){
						form.USPhone_DateOfBirthM.value = "";
						form.USPhone_DateOfBirthD.value = "";
						form.USPhone_DateOfBirthY.value = "";
					}else{
						str = "USPhone_"+ str
						if( eval("form."+str ) ){
							eval("form."+str ).value = "";
						}
					}
				}	
				++i
			}
			ok = 0;
		}
		++count;
	}
}

function setusphonebillbirthdate ( form, field ){

	if( form.bezahltyp.value == "USPhoneBill" && form.USPhone_DateOfBirthM ){

		if( form.DateOfBirthM.value && field == "DateOfBirthM" ) {
			form.USPhone_DateOfBirthM.value = form.DateOfBirthM.value 
		}else if ( form.USPhone_DateOfBirthM.value && field == "USPhone_DateOfBirthM" ){
			form.DateOfBirthM.value = form.USPhone_DateOfBirthM.value
		}

		if( form.DateOfBirthD.value && field == "DateOfBirthD") 
			form.USPhone_DateOfBirthD.value = form.DateOfBirthD.value 
		else if ( form.USPhone_DateOfBirthD.value && field == "USPhone_DateOfBirthD")
			form.DateOfBirthD.value = form.USPhone_DateOfBirthD.value

		if( form.DateOfBirthY.value && field == "DateOfBirthY" ) 
			form.USPhone_DateOfBirthY.value = form.DateOfBirthY.value 
		else if ( form.USPhone_DateOfBirthY.value && field == "USPhone_DateOfBirthY")
			form.DateOfBirthY.value = form.USPhone_DateOfBirthY.value

	}
}

