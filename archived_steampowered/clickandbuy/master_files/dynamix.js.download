function textedit( table,id,nation,lang,subclient ) {
    editw = window.open("/cgi-bin/callcenter/txtchng.pl?prv=1&table="+table+"&edit="+id+"&lang="+lang+"&nat="+nation+"&subclientid="+subclient,"txtedit","status=1,scrollbars=1,resizable=1,width=700,height=600");
