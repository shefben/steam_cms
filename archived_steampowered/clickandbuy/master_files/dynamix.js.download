//for promotion page

var countField;
var textField;
var intervalID;
var maxDscrLength = 200;

/* Triggered by onFocus()
 *
 */
function countDscrChars() {
    countField = document.promotion.chars;
    textField = document.promotion.limitedtextarea;
    intervalID = setInterval("doCount()", 30);
}

/* Triggered by onBlur()
 * 
 */
function stopCounting() {
    clearInterval(intervalID);
}

/* Started by event handler
 * Stops pastes and keypresses.
 */
function doCount() {
    countField = document.promotion.chars;
    textField = document.promotion.limitedtextarea;
    countField.value = maxDscrLength - textField.value.length;
    if (textField.value.length > maxDscrLength) {
        var dscrText = textField.value.substring(0, maxDscrLength);
        textField.value = dscrText;
        
    }
}

/* Triggered by onkeyup()
 * Prevents entered data through keypresses gracefully.
 */
function checkLength(field, e) {
    var charCode = (navigator.appName == "Netscape") ? e.which : e.keyCode;
    //alert(charCode);
    if (field.value.length >= maxDscrLength) {
        /* Allow backspace (8)
         * Allow Arrow keys and Delete key (0)
         */
        if (charCode != 8 && charCode != 0) {
            return false;
        }
    }
}


//disable the submit button after accepting payment for startsession, startsubscription and ddauthaccept
function disableSubmit(){
	if( document.getElementById('confirmdiv') ){
		document.getElementById('confirmdiv').className =  "button_gray";
		document.getElementById('confirmbutton').disabled = true;
		document.getElementById('confirmbutton').className = "button_gray";
		document.getElementById('pleaseWait').style.display = "block";

	}
}

function clickedPayPerMinute(form) {
	if (form.IsPayPerMinute && form.IsPayPerMinute.checked) {
		form.IsTransaction.checked = false;
		form.rollbackManualCommit.disabled = false;
	}

	configPayPerMinute(form);
}

function DisableTransactionTypes(form) {

	if( form ) {
		if( form.IsTransaction.checked ) {
			form.bdraction[1].checked = true;	
			form.rollbackManualCommit.disabled = true;
			form.rollbackManualCommit.checked = false;
			//form.IsPayPerMinute.checked = false;
		}else{
			form.rollbackManualCommit.disabled = false;
		}	

		configPayPerMinute(form);

	}
}	

function configPayPerMinute(form) {
	if (form.IsPayPerMinute && form.IsPayPerMinute.checked) {
		form.bdraction[0].disabled = false;
	} else {
		if( form.bdraction[0] ){
			form.bdraction[0].checked = false;
			form.bdraction[0].disabled = true;
		}

		if( form.bdraction[1] )
			form.bdraction[1].checked = true;
	}

	if( form.bdraction[1] && form.bdraction[1].checked ){
		setVisible('customFieldQQ', true);	
	}
}

var alertShown;
/**
 * Always show the warning for the change in BDR Type. Additionally, show a 
 * warning for manual commit if the manual commit checkbox is selected.
 * 
 * After user clicks on "Ok", user must click on submit button again.
 */
function showAlert(form, bdrMsg, commitMsg, saveSettingsMsg) {
	var msg = "";
	if ( form.IsPayPerMinute && form.IsPayPerMinute.checked) {
		msg += bdrMsg;
	}
	if (form.rollbackManualCommit.checked) {
		msg += "\n\n" + commitMsg;
	}
	
	//Add the message which explains that the submit button has to be clicked again to save the data
	if (!msg) {
		return true;
	}

 	msg += "\n\n" + saveSettingsMsg;

	if (!alertShown) {
		alert(msg);
		alertShown = 1;
		return false;
	} else {
		return true;
	}
}


