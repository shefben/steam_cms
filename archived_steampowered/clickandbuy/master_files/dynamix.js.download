//country or language change setup show variable and submit the form 
function CountryLangChange(){

	document.regform._show.value="mainpage"
	document.regform._page.value=""
	document.regform.submit()
}


function buttonSubmit ( buttonname, obj ) {
	if ( navigator.appName == "Microsoft Internet Explorer" ) {
       		var elements = document.all;
		var buttonfound = 0;
		if ( elements ) {

			for (i=0; i < elements.length; i++) {
				if( elements.item(i).type == "submit" ){
				
					if( elements.item(i).name != "X_"+buttonname ){
						elements.item(i).name = "X_";
					}else{
					    buttonfound = 1;
					}
				}
			}
				// set  clicked button name
				
		}
	        if( ! buttonfound && obj ) {
			obj.name = "X_"+buttonname;
		}
	}
}

function showpage( f, v ) {

	if( f._page )
		f._page.value = "";
	
	if( f._show )
		f._show.value = v; 
	
	f.submit()
}


