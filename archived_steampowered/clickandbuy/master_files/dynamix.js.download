}

// email preview javascript function
function previewemail( typ ,name ){
       document.emailpreviewform.type.value = typ;
       varname = "document.subscriptionemail."+name+".value";
       document.emailpreviewform.MerchantText.value = eval( varname );
       document.emailpreviewform.submit();	
}

// set button width for IE browsers
function setButtonWidth(){
	if( document.regform && document.regform.jsenabled ){
		document.regform.jsenabled.value = "yes";
	}

	if( document.loginform && document.loginform.cb_param_js ){
		document.loginform.cb_param_js.value = "yes";
        }

	var w;
	if ( navigator.appName == "Microsoft Internet Explorer" ) {
       		var elements = document.all
		if ( elements ) {

			for (i=0; i < elements.length; i++) {
				w = 12;
				if( elements.item(i).type == "submit"  ||  elements.item(i).type == "button" || elements.item(i).className.match(/hlinka/) ){
					//if( elements.item(i).id == "input" ) 
					 w = 20;
		               		//elements.tspan.innerText = elements.item(i).value;
					elements.tspan.innerHTML = elements.item(i).value;
					
					if (elements.item(i).className.match(/hlinka/)) {	// fix button width for IE7
						elements.tspan.innerHTML = elements.item(i).innerHTML;
						w=0;
					}

					 elements.item(i).name =  'X_' +elements.item(i).name
					if( elements.tspan.offsetWidth ) elements.item(i).style.width = elements.tspan.offsetWidth + w;
				}
				
			}	
		}
        }	
}	


//Hide/show enable/ disable form elements by ID - merch reg master question pages, link edit page in callcenter


function setVisible(element, visible) {
	var x=document.getElementById(element);
	if( x != null ) {
		if (visible) {
			x.disabled=false;
			x.style.visibility = "visible";
		} else {
			x.checked=false;
			x.style.visibility = "hidden";
			x.disabled=true;
		}
	}
}

//Deprecated!!! Replaced by setVisible
function makeEnabled(element) {
	var x=document.getElementById(element);
	x.disabled=false;
	x.style.visibility="visible";
}

