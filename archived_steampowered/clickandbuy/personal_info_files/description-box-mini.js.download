function findPosXY(obj){var curleft=0;var curtop=0;if(obj.offsetParent){curtop+=obj.offsetHeight;while(obj.offsetParent){curtop+=obj.offsetTop;curleft+=obj.offsetLeft;obj=obj.offsetParent;}}
