function checkStrength(user,pw){if(null==pw||null==user)return;var rqa=pw.length>5;var rqb=/[ÀÁÂÃÄÅÆÇÈÉÊËÌÍÎÏÐÑÒÓÔÕÖØÙÚÛÜÝßàáâãäåæçèéêëìíîïðñòóôõöøùúûüýÿ°º!@#%&()_=:,\[\]\*\.\?\;\^\$\-\+\/]/.test(pw);var rqc=/[0-9]/.test(pw);var rqd=/[A-Z]/.test(pw);var total=0;if(rqa)total+=1;if(rqb)total+=1;if(rqc)total+=1;if(rqd)total+=1;var ub;var lb;switch(total){case 0:case 1:case 2:lb=0;ub=19;break;case 3:if(rqa&&rqb){lb=40;ub=40;}else{lb=20;ub=39;}
break;default:lb=41;ub=59;}
var lngth=pw.length;if(lngth>12)lngth=12;return(ub-lb)/12*lngth+lb;}
