document.getElementById('ccbillingaddress2').style.display='none';if(!flag&&document.getElementById('ccbillingaddress'))
document.getElementById('ccbillingaddress').style.display='none';ccselectindex(form,ccindex);if(validatorFlag==1){try{field_validator(null,'Kartentyp');}catch(e){}}else{validatorFlag=1;}}
