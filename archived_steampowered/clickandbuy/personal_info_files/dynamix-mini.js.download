function wallet_cc_updated(cc_field,cctype_field){var cctype_list=document.getElementById(cctype_field);if(cctype_list==null)return;if(null==document.getElementById(cc_field))return;var cc_num=document.getElementById(cc_field).value;cc_num=cc_num.replace(/\D/g,'');var cctype=cctype_list.options[cctype_list.selectedIndex].value;if(cctype=="VISA"||cctype=="MasterCard"){if(cc_num.length!=16)return;document.getElementById(cc_field).value=cc_num.substring(0,4)+' '+
cc_num.substring(4,8)+' '+
