function setSelectWidth(s,w){var browser=navigator.appName;if(browser=="Microsoft Internet Explorer"){var bversion=navigator.appVersion.split("MSIE");if(bversion){var version=parseFloat(bversion[1]);if(version<7){return;}}else{return;}}
if(s!=null){val=s[s.selectedIndex].value;if(val!=null){element=document.getElementById("tspan");if(element!=null){element.innerHTML=val;if(element.offsetWidth>w)
s.style.width=element.offsetWidth+'px';else
s.style.width=w+'px';}}else{s.style.width=w+'x';}}}
function setSelectMaxWidth(s,w){var browser=navigator.appName;if(browser=="Microsoft Internet Explorer"){var bversion=navigator.appVersion.split("MSIE");if(bversion){var version=parseFloat(bversion[1]);if(version<7){return;}}else{return;}}
maxwidth=w;if(s!=null){var count=s.length
element=document.getElementById("tspan");if(element!=null){for(i=0;i<count;++i){if(s[i]){val=s[i].value;element.innerHTML=val;if(element.offsetWidth>maxwidth)
maxwidth=element.offsetWidth}}}
if(maxwidth>w)
s.style.width=maxwidth+'px';}}
function setelementwidth(e,w){var browser=navigator.appName;if(browser=="Microsoft Internet Explorer"){var bversion=navigator.appVersion.split("MSIE");if(bversion){var version=parseFloat(bversion[1]);if(version<7){return;}}else{return;}}
