cc_num.substring(4,10)+' '+
cc_num.substring(10);}}
function get_new_captcha_url(url){var now=new Date();var rand_val=now.getTime();var idx=url.indexOf('randkey=');if(idx>0){url=url.replace(/randkey=\d+/,"randkey="+rand_val);}else{url=url.substring(0,url.length-2);url=url+"&randkey="+rand_val+")";}
return url;}
function reload_captcha_image_by_class(){var theRules=new Array();if(document.styleSheets[1].cssRules)
theRules=document.styleSheets[document.styleSheets.length-1].cssRules;else if(document.styleSheets[1].rules)
theRules=document.styleSheets[document.styleSheets.length-1].rules;var url=get_new_captcha_url(theRules[0].style.backgroundImage);theRules[0].style.backgroundImage=url;return false;}
function reload_captcha_image_by_div(cap){if(null==cap||'DIV'!=cap.nodeName)return;var url=get_new_captcha_url(cap.style.backgroundImage);cap.style.backgroundImage=url;}
function reg3Dcc_toggle(flag){if(flag){if(document.getElementById('regCC3D_A'))document.getElementById('regCC3D_A').style.display='none';if(document.getElementById('regCC3D_B'))document.getElementById('regCC3D_B').style.display='none';if(document.getElementById('regCC3D_C'))document.getElementById('regCC3D_C').style.display='none';if(document.getElementById('regCC3D_D'))document.getElementById('regCC3D_D').style.display='none';if(document.getElementById('regCC3D_E'))document.getElementById('regCC3D_E').style.display='';if(document.getElementById('regCC3D_F'))document.getElementById('regCC3D_F').style.display='';if(document.getElementById('regCC3D_G'))document.getElementById('regCC3D_G').style.display='';if(document.regform.regcc3d_result)document.regform.regcc3d_result.value='';}else{if(document.getElementById('regCC3D_A'))document.getElementById('regCC3D_A').style.display='';if(document.getElementById('regCC3D_B'))document.getElementById('regCC3D_B').style.display='';if(document.getElementById('regCC3D_C'))document.getElementById('regCC3D_C').style.display='';if(document.getElementById('regCC3D_D'))document.getElementById('regCC3D_D').style.display='';if(document.getElementById('regCC3D_E'))document.getElementById('regCC3D_E').style.display='none';if(document.getElementById('regCC3D_F'))document.getElementById('regCC3D_F').style.display='none';if(document.getElementById('regCC3D_G'))document.getElementById('regCC3D_G').style.display='none';}}
function showwalletpayment(id,img,hide,pc){var pblocks=new Array();pblocks[0]="dd";pblocks[1]="DD_error";pblocks[2]="omt";pblocks[3]="OMT_error";pblocks[4]="cc";pblocks[5]="CC_error";pblocks[6]="prepaidpin";pblocks[7]="PREPAIDPIN_error";pblocks[8]="mt";pblocks[9]="MT_error";pblocks[10]="mtbb";pblocks[11]="MTBB_error";pblocks[12]="omt_giropay";pblocks[13]="omt_sofort";pblocks[14]="omt_ideal";pblocks[15]="omt_eps";for(var x in pblocks){if(document.getElementById(pblocks[x])){document.getElementById(pblocks[x]).style.display="none";if(document.getElementById(pblocks[x]+'arrowdown'))
document.getElementById(pblocks[x]+'arrowdown').style.display='none';if(document.getElementById(pblocks[x]+'arrowup'))
document.getElementById(pblocks[x]+'arrowup').style.display='block';}}
if(id&&document.getElementById(id)&&hide=='hide'){document.getElementById(id).style.display='none';}else if(id&&document.getElementById(id)){document.getElementById(id).style.display='block';if(document.selectpayment&&document.selectpayment.cb_param_paymentchannel&&pc)
document.selectpayment.cb_param_paymentchannel.value=pc;}
switch(id){case"cc":if(document.getElementById("CC_error")!=null)
document.getElementById("CC_error").style.display="block";break;case"dd":if(document.getElementById("DD_error")!=null)
document.getElementById("DD_error").style.display="block";break;case"omt":if(document.getElementById("OMT_error")!=null)
document.getElementById("OMT_error").style.display="block";break;case"prepaidpin":break;case"mt":break;}
if(img&&img=="arrowup"){if(document.getElementById(id+'arrowup')){document.getElementById(id+'arrowup').style.display='none';}
if(document.getElementById(id+'arrowdown'))
document.getElementById(id+'arrowdown').style.display='block';}
if(img&&img=="arrowdown"){if(document.getElementById(id+'arrowdown'))
document.getElementById(id+'arrowdown').style.display='none';if(document.getElementById(id+'arrowup'))
document.getElementById(id+'arrowup').style.display='block';}}
function sendSMS(){var land=document.regform.Land.value;var lang=document.regform.lang.value;var mp=document.regform.handynr.value;if(!checkPhoneNumber('handynr',land)){return;}
var xhr;var xhrTimeout;try{xhr=window.XMLHttpRequest?new XMLHttpRequest():new ActiveXObject("Microsoft.XMLHTTP");}catch(e){return;}
xhr.onreadystatechange=function(){if(xhr.readyState==4&&xhr.status==200){clearTimeout(xhrTimeout);var r=eval('('+xhr.responseText+')');var ok=r[0];var error=r[1];}};xhrTimeout=setTimeout(function(){xhr.abort();},15000);xhr.open('GET','/cgi-bin/register.pl?mode=premiumlink&_page=regsendsms&handynr='+mp+'&Land='+land+'&lang='+land,true);xhr.send(null);}
function setbreadcrumb_position(){if(document.getElementById('breadcrumb')){var total;if(document.getElementById('breadcrumb').offsetWidth>=600)
total=600;else
total=document.getElementById('breadcrumb').offsetWidth-20;var elements=document.getElementById('breadcrumb').childNodes;var ew;if(elements){var count=0;for(i=0;i<elements.length;i++){if(elements.item(i).tagName=="SPAN"){if(ew&&elements.item(i).offsetWidth>0)
ew=ew+elements.item(i).offsetWidth;else if(elements.item(i)&&elements.item(i).offsetWidth>0)
ew=elements.item(i).offsetWidth;++count;}}}
division=count/2-1;total=total-(count/2*23);w=total-ew;if(w>0){d=parseInt(w/division);for(j=1;j<=division;j++){num=j+1
c=j*d;if(document.getElementById('bd'+num)){document.getElementById('bd'+num).style.position='relative';document.getElementById('bd'+num).style.left=c+'px';}
if(document.getElementById('stepselected'+num+'a')){document.getElementById('stepselected'+num+'a').style.position='relative';document.getElementById('stepselected'+num+'a').style.left=c+'px';}}}else{division=count/2;d=parseInt(total/division);d=d-20;var r=0;var c=0;for(j=1;j<=division;j++){if(document.getElementById('bd'+j)&&(document.getElementById('bd'+j).offsetWidth<d)){r=r+d-document.getElementById('bd'+j).offsetWidth;}else{c++}}
d=d+parseInt(r/c);d=d-20;for(j=1;j<=division;j++){if(document.getElementById('bd'+j)&&document.getElementById('bd'+j).offsetWidth>d){document.getElementById('bd'+j).style.width=d+'px';document.getElementById('bd'+j).style.paddingTop='0px';document.getElementById('bd'+j).style.paddingBottom='4px';}
if(j>1){if(document.getElementById('bd'+j)){document.getElementById('bd'+j).style.position='relative';document.getElementById('bd'+j).style.left='5px';}
if(document.getElementById('stepselected'+j+'a')){document.getElementById('stepselected'+j+'a').style.position='relative';document.getElementById('stepselected'+j+'a').style.left='5px';}}}}}
return false;}

}
